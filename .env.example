# Copy to .env. Points at the vLLM container started by compose.yaml.
VLLM_ENDPOINT=http://127.0.0.1:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=RedHatAI/Qwen3.8-27B-INT4

# vLLM serve options file in ./vllm: serve.yaml (page extraction, vision) or
# serve.retrieval.yaml (retrieval experiments, notebooks 07-08)
VLLM_CONFIG=serve.retrieval.yaml
# CPU encoder (bge-m3, bge-reranker-v2-m3, jina-reranker-v3) and Qdrant
ENCODER_URL=http://127.0.0.1:8081
ENCODER_THREADS=12
QDRANT_URL=http://127.0.0.1:6333
# bge-m3 tokenizer.json for token counts (relative to the repo root)
BGE_M3_TOKENIZER=../etoeragcb/model-cache/huggingface/hub/models--BAAI--bge-m3/snapshots/5617a9f61b028005a4858fdac845db406aefb181/tokenizer.json
